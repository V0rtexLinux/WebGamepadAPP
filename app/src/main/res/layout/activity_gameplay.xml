<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen game WebView (bottom layer) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Virtual on-screen gamepad (transparent overlay, full-screen) -->
    <com.gamemapper.views.VirtualGamepadView
        android:id="@+id/virtualGamepad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading indicator (top edge, above gamepad) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loadingBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- Floating mini-toolbar: Back + Gamepad toggle + Overlay toggle -->
    <LinearLayout
        android:id="@+id/floatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#AA0D0D1A"
        android:padding="4dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp">

        <!-- Exit game -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/on_surface_medium"
            android:background="@drawable/ripple_circle"
            android:contentDescription="Sair do jogo" />

        <!-- Toggle virtual gamepad visibility -->
        <ImageButton
            android:id="@+id/btnToggleGamepad"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_gamepad"
            android:tint="@color/accent"
            android:background="@drawable/ripple_circle"
            android:layout_marginTop="4dp"
            android:contentDescription="Mostrar/ocultar gamepad" />

        <!-- Mapping overlay toggle -->
        <ImageButton
            android:id="@+id/btnToggleOverlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_radar"
            android:tint="@color/purple_keyboard"
            android:background="@drawable/ripple_circle"
            android:layout_marginTop="4dp"
            android:contentDescription="Ver mapeamento" />

    </LinearLayout>

    <!-- Mapping overlay card (bottom-left, toggled by btnToggleOverlay) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/overlayCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#EE0D0D1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="80dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:maxHeight="260dp">

            <TextView
                android:id="@+id/tvOverlayContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="@color/on_surface_medium"
                android:textSize="11sp"
                android:fontFamily="monospace" />

        </ScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
