<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen game WebView (bottom layer) -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Enhanced virtual gamepad overlay (v2: neon/glassmorphism themes) -->
    <com.gamemapper.views.VirtualGamepadView
        android:id="@+id/virtualGamepad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading progress bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loadingBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- Farm status overlay (top-left, compact pill) -->
    <com.gamemapper.views.FarmStatusView
        android:id="@+id/farmStatusView"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/floatingControls" />

    <!-- Mapping overlay (shows active control zones) -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating control panel (right edge) -->
    <LinearLayout
        android:id="@+id/floatingControls"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC0D1020"
        android:padding="4dp"
        android:gravity="center"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp">

        <!-- Exit game -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFAAAAAA"
            android:background="@drawable/ripple_circle"
            android:contentDescription="Sair" />

        <!-- Toggle gamepad visibility -->
        <ImageButton
            android:id="@+id/btnToggleGamepad"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_gamepad"
            android:tint="@color/accent"
            android:background="@drawable/ripple_circle"
            android:layout_marginTop="2dp"
            android:contentDescription="Gamepad" />

        <!-- Mapping overlay toggle -->
        <ImageButton
            android:id="@+id/btnToggleOverlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_radar"
            android:tint="#FFCC88FF"
            android:background="@drawable/ripple_circle"
            android:layout_marginTop="2dp"
            android:contentDescription="Mapeamento" />

        <!-- Farm toggle -->
        <ImageButton
            android:id="@+id/btnFarm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_farm"
            android:tint="#FFFFD700"
            android:background="@drawable/ripple_circle"
            android:layout_marginTop="2dp"
            android:contentDescription="Auto-Farm" />

        <!-- Gamepad settings -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#FF88AAFF"
            android:background="@drawable/ripple_circle"
            android:layout_marginTop="2dp"
            android:contentDescription="Configurações" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
