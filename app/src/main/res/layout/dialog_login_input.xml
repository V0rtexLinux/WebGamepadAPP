<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Pinguim"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/accent"
        app:boxBackgroundColor="@color/surface_variant"
        app:hintTextColor="@color/on_surface_medium"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ex: PinguimFeliz123"
            android:inputType="text"
            android:textColor="@color/on_primary"
            android:textColorHint="@color/on_surface_low"
            android:imeOptions="actionNext"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Senha"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/accent"
        app:boxBackgroundColor="@color/surface_variant"
        app:hintTextColor="@color/on_surface_medium"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/on_surface_medium">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sua senha"
            android:inputType="textPassword"
            android:textColor="@color/on_primary"
            android:textColorHint="@color/on_surface_low"
            android:imeOptions="actionDone"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="⚠️ Suas credenciais são usadas apenas para preencher o formulário de login do jogo. O GameMapper não armazena senhas."
        android:textColor="@color/on_surface_low"
        android:textSize="11sp" />

</LinearLayout>
